{
  "name": "@harvard-lil/perma-js-sdk",
  "version": "0.0.5",
  "description": "A JavaScript library to interact with Perma.cc's REST API",
  "main": "index.js",
  "type": "module",
  "files": [
    "doc/",
    "index.js",
    "types.js"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest index.unit.test.js index.mock.test.js --runInBand --coverage",
    "test-unit": "NODE_OPTIONS=--experimental-vm-modules jest index.unit.test.js --runInBand",
    "test-mocked": "NODE_OPTIONS=--experimental-vm-modules jest index.mock.test.js --runInBand",
    "test-live": "NODE_OPTIONS=--experimental-vm-modules jest index.integration.test.js --runInBand --testTimeout=90000 --setupFiles dotenv/config",
    "test-integration": "npm run test-live",
    "test-integration-local": "npm run test-live",
    "docgen": "jsdoc2md index.js > doc/index.md && jsdoc2md types.js > doc/types.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvard-lil/perma-js-sdk.git"
  },
  "keywords": [
    "web-archiving",
    "libraries"
  ],
  "author": "Harvard Library Innovation Lab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harvard-lil/perma-js-sdk/issues"
  },
  "homepage": "https://github.com/harvard-lil/perma-js-sdk#readme",
  "devDependencies": {
    "dotenv": "^17.4.2",
    "jest": "^30.5.1",
    "jsdoc-to-markdown": "^9.1.3",
    "prettier": "^3.9.6"
  }
}
